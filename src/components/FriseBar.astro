---
interface Item {
  name: string;
  desc?: string;
  tag?: string;
  url?: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;

function hash(s: string) {
  let h = 0;
  for (let i = 0; i < s.length; i++) {
    h = (h * 31 + s.charCodeAt(i)) >>> 0;
  }
  return h;
}

// Muted accent palette, cycled deterministically per item. Used only as a
// thin top rule and hover tint so the strip stays calm on the dark background.
const palette = [
  { bg: '#b8ad3a', fg: '#0a0a0a' }, // dim yellow
  { bg: '#4fa3ab', fg: '#0a0a0a' }, // teal
  { bg: '#b05a7a', fg: '#0a0a0a' }, // dusty pink
  { bg: '#7d68b0', fg: '#f5f5f5' }, // soft violet
  { bg: '#6f9a4e', fg: '#0a0a0a' }, // moss green
  { bg: '#b87a45', fg: '#0a0a0a' }, // burnt orange
];
const colors = items.map((item, i) => palette[(hash(item.name) + i) % palette.length]);
---
<div class="frise">
  {items.map((item, i) => {
    const Tag = item.url ? 'a' : 'div';
    return (
      <Tag
        class="frise__segment"
        style={`--neon:${colors[i].bg};--neon-fg:${colors[i].fg}`}
        href={item.url}
        target={item.url ? '_blank' : undefined}
        rel={item.url ? 'noopener noreferrer' : undefined}
        tabindex={item.url ? undefined : 0}
      >
        <span class="frise__label">{item.name}</span>
        <div class="frise__panel">
          <div class="frise__panel-name">{item.name}</div>
          {item.tag && <div class="frise__panel-tag">{item.tag}</div>}
          {item.desc && <div class="frise__panel-desc">{item.desc}</div>}
        </div>
      </Tag>
    );
  })}
</div>
