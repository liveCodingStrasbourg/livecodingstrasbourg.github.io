---
interface Item {
  name: string;
  desc?: string;
  tag?: string;
  url?: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;

function hash(s: string) {
  let h = 0;
  for (let i = 0; i < s.length; i++) {
    h = (h * 31 + s.charCodeAt(i)) >>> 0;
  }
  return h;
}

// Fixed neon palette, cyberpunk-flavored — cycled deterministically per item
// rather than a smooth gradient, so the strip reads as punchy and varied.
const palette = [
  { bg: '#fcee0a', fg: '#0a0a0a' }, // electric yellow
  { bg: '#00f0ff', fg: '#0a0a0a' }, // cyan
  { bg: '#ff2079', fg: '#0a0a0a' }, // hot pink
  { bg: '#7b2ff7', fg: '#f5f5f5' }, // violet
  { bg: '#39ff14', fg: '#0a0a0a' }, // acid green
  { bg: '#ff6a00', fg: '#0a0a0a' }, // neon orange
];
const colors = items.map((item, i) => palette[(hash(item.name) + i) % palette.length]);
---
<div class="frise">
  {items.map((item, i) => {
    const Tag = item.url ? 'a' : 'div';
    return (
      <Tag
        class="frise__segment"
        style={`--neon:${colors[i].bg};--neon-fg:${colors[i].fg}`}
        href={item.url}
        target={item.url ? '_blank' : undefined}
        rel={item.url ? 'noopener noreferrer' : undefined}
        tabindex={item.url ? undefined : 0}
      >
        <span class="frise__label">{item.name}</span>
        <div class="frise__panel">
          <div class="frise__panel-name">{item.name}</div>
          {item.tag && <div class="frise__panel-tag">{item.tag}</div>}
          {item.desc && <div class="frise__panel-desc">{item.desc}</div>}
        </div>
      </Tag>
    );
  })}
</div>
