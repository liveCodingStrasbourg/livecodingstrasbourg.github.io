---
import '../styles/global.css';
import { getLangFromUrl, useTranslations, getLocalePath, languages } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { title, description, image } = Astro.props;

const pageTitle = title ? `${title} — LiveCoding Strasbourg` : 'LiveCoding Strasbourg';
const pageDesc = description ?? t('site.tagline');
const ogImage = new URL(image ?? '/images/livecoding-stras.webp', Astro.site ?? Astro.url).toString();
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();

const otherLang = lang === 'fr' ? 'en' : 'fr';
const otherLangLabel = languages[otherLang];
const currentPath = Astro.url.pathname;
let altPath: string;
if (lang === 'fr') {
  altPath = `/en${currentPath}`;
} else {
  altPath = currentPath.replace(/^\/en/, '') || '/';
}

const navLinks = [
  { href: getLocalePath(lang, '/agenda'), label: t('nav.agenda') },
  { href: getLocalePath(lang, '/artists'), label: t('nav.artists') },
  { href: getLocalePath(lang, '/ressources'), label: t('nav.tools') },
  { href: getLocalePath(lang, '/projects'), label: t('nav.projects') },
  { href: getLocalePath(lang, '/media'), label: t('nav.media') },
  { href: getLocalePath(lang, '/contact'), label: t('nav.contact') },
];
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <script is:inline>
    try {
      const saved = localStorage.getItem('theme');
      if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
    } catch {}
  </script>
  <title>{pageTitle}</title>
  <meta name="description" content={pageDesc} />
  <link rel="canonical" href={canonicalURL} />
  <link rel="alternate" hreflang={otherLang} href={altPath} />
  <link rel="alternate" type="application/rss+xml" title="TOPLAP Strasbourg — Agenda" href="/rss.xml" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDesc} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_US'} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={pageDesc} />
  <meta name="twitter:image" content={ogImage} />
</head>
<body>
  <header class="site-header">
    <div class="site-header__top">
      <a href={getLocalePath(lang, '/')} class="site-title" data-text="LiveCodingStrasbourg">
        LiveCoding<span>Strasbourg</span>
      </a>
      <div class="site-header__actions">
        <button
          type="button"
          class="theme-toggle"
          data-label-light={lang === 'fr' ? 'Passer en mode clair' : 'Switch to light mode'}
          data-label-dark={lang === 'fr' ? 'Passer en mode sombre' : 'Switch to dark mode'}
        >
          <span class="theme-toggle__to-light">{lang === 'fr' ? 'Clair' : 'Light'}</span>
          <span class="theme-toggle__to-dark">{lang === 'fr' ? 'Sombre' : 'Dark'}</span>
        </button>
        <a href={altPath} class="lang-switch">{otherLangLabel}</a>
      </div>
    </div>
    <nav class="site-nav" aria-label="Navigation principale">
      {navLinks.map(({ href, label }) => (
        <a href={href} aria-current={Astro.url.pathname === href ? 'page' : undefined}>
          {label}
        </a>
      ))}
    </nav>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <p>
      LiveCoding Strasbourg &mdash; {new Date().getFullYear()}
      &nbsp;·&nbsp; <a href="/rss.xml">RSS</a>
    </p>
  </footer>
  <script is:inline>
    (() => {
      const btn = document.querySelector('.theme-toggle');
      if (!btn) return;
      const root = document.documentElement;
      const current = () =>
        root.dataset.theme ?? (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
      const sync = () => {
        const label = current() === 'dark' ? btn.dataset.labelLight : btn.dataset.labelDark;
        btn.setAttribute('aria-label', label);
        btn.title = label;
      };
      btn.addEventListener('click', () => {
        const next = current() === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch {}
        sync();
      });
      sync();
    })();
  </script>
</body>
</html>
