---
import '../styles/global.css';
import ToplapLogo from '../components/ToplapLogo.astro';
import { getLangFromUrl, useTranslations, getLocalePath, languages } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  /** Page in the other language; false when there is none (hides the switch). */
  alternate?: string | false;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { title, description, image, noindex, alternate } = Astro.props;

const pageTitle = title ? `${title} — LiveCoding Strasbourg` : 'LiveCoding Strasbourg';
const pageDesc = description ?? t('site.tagline');
const ogImage = new URL(image ?? '/images/og-toplap-strasbourg.png', Astro.site ?? Astro.url).toString();
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();

const otherLang = lang === 'fr' ? 'en' : 'fr';
const otherLangLabel = languages[otherLang];
const currentPath = Astro.url.pathname;
let altPath: string | false;
if (alternate !== undefined) {
  altPath = alternate;
} else if (lang === 'fr') {
  altPath = `/en${currentPath}`;
} else {
  altPath = currentPath.replace(/^\/en/, '') || '/';
}

const navLinks = [
  { href: getLocalePath(lang, '/agenda'), label: t('nav.agenda') },
  { href: getLocalePath(lang, '/artists'), label: t('nav.artists') },
  { href: getLocalePath(lang, '/ressources'), label: t('nav.tools') },
  { href: getLocalePath(lang, '/projects'), label: t('nav.projects') },
  { href: getLocalePath(lang, '/media'), label: t('nav.media') },
  { href: getLocalePath(lang, '/contact'), label: t('nav.contact') },
];
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <script is:inline>
    try {
      const saved = localStorage.getItem('theme');
      if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
    } catch {}
  </script>
  <title>{pageTitle}</title>
  <meta name="description" content={pageDesc} />
  <link rel="canonical" href={canonicalURL} />
  {noindex && <meta name="robots" content="noindex" />}
  {altPath && <link rel="alternate" hreflang={otherLang} href={altPath} />}
  <link rel="alternate" type="text/calendar" title="TOPLAP Strasbourg — Agenda" href="/agenda.ics" />
  <link rel="alternate" type="application/rss+xml" title="TOPLAP Strasbourg — Agenda" href="/rss.xml" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <meta property="og:type" content="website" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDesc} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:locale" content={lang === 'fr' ? 'fr_FR' : 'en_US'} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={pageDesc} />
  <meta name="twitter:image" content={ogImage} />
</head>
<body>
  <header class="site-header">
    <div class="site-header__top">
      <a href={getLocalePath(lang, '/')} class="site-title" aria-label={lang === 'fr' ? 'TOPLAP Strasbourg — accueil' : 'TOPLAP Strasbourg — home'}>
        <ToplapLogo class="site-title__logo" />
      </a>
      <div class="site-header__actions">
        <button
          type="button"
          class="theme-toggle"
          data-label-light={lang === 'fr' ? 'Passer en mode clair' : 'Switch to light mode'}
          data-label-dark={lang === 'fr' ? 'Passer en mode sombre' : 'Switch to dark mode'}
        >
          <span class="theme-toggle__to-light">{lang === 'fr' ? 'Clair' : 'Light'}</span>
          <span class="theme-toggle__to-dark">{lang === 'fr' ? 'Sombre' : 'Dark'}</span>
        </button>
        {altPath && <a href={altPath} class="lang-switch">{otherLangLabel}</a>}
      </div>
    </div>
    <nav class="site-nav" aria-label="Navigation principale">
      {navLinks.map(({ href, label }) => (
        <a href={href} aria-current={Astro.url.pathname === href ? 'page' : undefined}>
          {label}
        </a>
      ))}
      <form class="site-search" role="search" action={lang === 'fr' ? '/agenda/' : '/en/agenda/'} onsubmit="return false">
        <input
          type="search"
          id="site-search-input"
          placeholder={lang === 'fr' ? 'Rechercher…' : 'Search…'}
          aria-label={lang === 'fr' ? 'Rechercher sur le site' : 'Search the site'}
          autocomplete="off"
          data-lang={lang}
          data-empty={lang === 'fr' ? 'Aucun résultat' : 'No results'}
        />
        <ul class="site-search__results" id="site-search-results" role="listbox" hidden></ul>
      </form>
    </nav>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site-footer">
    <p>
      LiveCoding Strasbourg &mdash; {new Date().getFullYear()}
      &nbsp;·&nbsp; <a href="/rss.xml">RSS</a>
    </p>
  </footer>
  <script is:inline>
    // Header search: loads /search.json on first focus, matches every word (accents ignored).
    (() => {
      const input = document.getElementById('site-search-input');
      const list = document.getElementById('site-search-results');
      if (!input || !list) return;
      const en = input.dataset.lang === 'en';
      const KIND = en
        ? { event: 'Event', artist: 'Artist', tool: 'Tool', project: 'Project', page: 'Page' }
        : { event: 'Agenda', artist: 'Artiste', tool: 'Outil', project: 'Projet', page: 'Page' };
      const norm = s => (s || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
      let index = null, active = -1, shown = [];
      const load = () => index ??= fetch('/search.json').then(r => r.json()).then(entries => entries.map(e => {
        const t = en ? (e.te || e.t) : e.t, d = en ? (e.de || e.d) : e.d;
        return { ...e, title: t, text: d, url: en ? (e.ue || e.u) : e.u, hay: norm(`${t} ${e.t} ${e.te || ''} ${e.s || ''} ${d}`), head: norm(`${t} ${e.t} ${e.s || ''}`) };
      })).catch(() => []);
      const render = () => {
        list.replaceChildren(...(shown.length ? shown : [null]).map((e, i) => {
          const li = document.createElement('li');
          if (!e) { li.className = 'site-search__empty'; li.textContent = input.dataset.empty; return li; }
          li.setAttribute('role', 'option');
          if (i === active) li.className = 'is-active';
          const a = document.createElement('a');
          a.href = e.url;
          if (/^https?:/.test(e.url)) { a.target = '_blank'; a.rel = 'noopener noreferrer'; }
          const kind = document.createElement('span');
          kind.className = 'site-search__kind';
          kind.textContent = KIND[e.k] + (e.y ? ' · ' + new Date(e.y).toLocaleDateString(en ? 'en-GB' : 'fr-FR', { day: 'numeric', month: 'short', year: 'numeric' }) : '');
          const title = document.createElement('span');
          title.className = 'site-search__title';
          title.textContent = e.title;
          a.append(kind, title);
          li.append(a);
          return li;
        }));
        list.hidden = false;
      };
      const search = async () => {
        const words = norm(input.value).split(/[\s_-]+/).filter(Boolean);
        if (!words.length) { list.hidden = true; shown = []; return; }
        const entries = await load();
        shown = entries
          .filter(e => words.every(w => e.hay.includes(w)))
          .map(e => ({ e, score: words.filter(w => e.head.includes(w)).length * 10 + (e.k === 'event' ? 1 : 2) }))
          .sort((a, b) => b.score - a.score)
          .slice(0, 8)
          .map(x => x.e);
        active = -1;
        render();
      };
      input.addEventListener('focus', load, { once: true });
      input.addEventListener('input', search);
      input.addEventListener('keydown', e => {
        if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
          if (!shown.length) return;
          e.preventDefault();
          active = (active + (e.key === 'ArrowDown' ? 1 : -1) + shown.length) % shown.length;
          render();
        } else if (e.key === 'Enter') {
          const pick = shown[Math.max(active, 0)];
          if (pick) { e.preventDefault(); list.querySelectorAll('a')[Math.max(active, 0)]?.click(); }
        } else if (e.key === 'Escape') {
          list.hidden = true; input.blur();
        }
      });
      document.addEventListener('click', e => { if (!e.target.closest('.site-search')) list.hidden = true; });
    })();
  </script>
  <script is:inline>
    // Mini clips play (muted) only while on screen; never for people asking for less motion.
    (() => {
      const clips = document.querySelectorAll('video[data-clip]');
      if (!clips.length || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const seen = new IntersectionObserver(entries => {
        for (const { target, isIntersecting } of entries) {
          if (isIntersecting) target.play().catch(() => {});
          else target.pause();
        }
      }, { threshold: 0.4 });
      clips.forEach(v => seen.observe(v));
    })();
  </script>
  <script is:inline>
    // Moving teaser thumbnails stay still for people who ask for less motion.
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.querySelectorAll('video[data-autoplay-thumb]').forEach(v => {
        v.removeAttribute('autoplay');
        v.pause();
      });
    }
  </script>
  <script is:inline>
    (() => {
      const btn = document.querySelector('.theme-toggle');
      if (!btn) return;
      const root = document.documentElement;
      const current = () =>
        root.dataset.theme ?? (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
      const sync = () => {
        const label = current() === 'dark' ? btn.dataset.labelLight : btn.dataset.labelDark;
        btn.setAttribute('aria-label', label);
        btn.title = label;
      };
      btn.addEventListener('click', () => {
        const next = current() === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try { localStorage.setItem('theme', next); } catch {}
        sync();
      });
      sync();
    })();
  </script>
</body>
</html>
