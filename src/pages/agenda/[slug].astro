---
import Base from '../../layouts/Base.astro';
import { getLangFromUrl, useTranslations } from '../../i18n';
import { getCollection } from 'astro:content';
import ArtistName from '../../components/ArtistName.astro';

export async function getStaticPaths() {
  const events = await getCollection('agenda');
  return events.map(e => ({ params: { slug: e.id }, props: { event: e } }));
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { event } = Astro.props;
const { data } = event;

const title = lang === 'en' && data.title_en ? data.title_en : data.title;
const subtitle = lang === 'en' && data.subtitle_en ? data.subtitle_en : data.subtitle;
const desc = lang === 'en' && data.description_en ? data.description_en : data.description;
const dateStr = new Date(data.date).toLocaleDateString(lang === 'fr' ? 'fr-FR' : 'en-GB', {
  weekday: 'long', day: 'numeric', month: 'long', year: 'numeric'
});
---
<Base title={title}>
  <p style="font-size:0.82rem;margin-bottom:1.2rem">
    <a href="/agenda">← {t('nav.agenda')}</a>
  </p>

  {data.cover_image && (
    <img src={data.cover_image} alt={title} class="event-cover" />
  )}

  <div class="page-header">
    <div style="font-size:0.82rem;color:var(--muted);margin-bottom:0.3rem">
      {dateStr}
      {data.time_start ? ` — ${data.time_start}${data.time_end ? ` – ${data.time_end}` : ''}` : ''}
      {data.duration ? ` — ${data.duration}` : ''}
    </div>
    <h1>{title}</h1>
    {subtitle && <p style="color:var(--accent2);margin:0.3rem 0 0">{subtitle}</p>}
  </div>

  {data.location && (
    <div style="font-size:0.9rem;color:var(--muted);margin-bottom:1rem">📍 {data.location}</div>
  )}

  <p style="line-height:1.7">{desc}</p>

  {data.participants?.length > 0 && (
    <div style="margin-top:1.2rem">
      <div style="font-size:0.78rem;color:var(--muted);text-transform:uppercase;letter-spacing:0.08em;margin-bottom:0.5rem">
        {lang === 'fr' ? 'Participants' : 'Performers'}
      </div>
      <ul style="list-style:none;padding:0;margin:0;display:flex;flex-wrap:wrap;gap:0.4rem">
        {data.participants.map((p: string, i: number) => (
          <li style="border:1px solid var(--border);padding:0.25rem 0.7rem;font-size:0.88rem">
            <ArtistName name={p} lang={lang} index={i} />
          </li>
        ))}
      </ul>
    </div>
  )}

  {data.tools?.length > 0 && (
    <div style="margin-top:1rem">
      <div style="font-size:0.78rem;color:var(--muted);text-transform:uppercase;letter-spacing:0.08em;margin-bottom:0.5rem">
        {lang === 'fr' ? 'Outils' : 'Tools'}
      </div>
      <div style="display:flex;flex-wrap:wrap;gap:0.35rem">
        {data.tools.map((tool: string) => <span class="tag">{tool}</span>)}
      </div>
    </div>
  )}

  {data.tags?.length > 0 && (
    <div style="margin-top:1rem">
      {data.tags.map((tag: string) => <span class="tag">{tag}</span>)}
    </div>
  )}

  {data.links?.length > 0 && (
    <div class="event-links" style="margin-top:1.5rem">
      {data.links.map((link: { label: string; url: string }) => (
        <a href={link.url} target="_blank" rel="noopener noreferrer" class="event-link">
          ↗ {link.label}
        </a>
      ))}
    </div>
  )}

  {data.video_url && (
    <>
      <hr />
      <div class="video-wrapper">
        <iframe
          src={data.video_url}
          title={title}
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        />
      </div>
    </>
  )}

  {data.photos?.length > 0 && (
    <>
      <hr />
      <div style="font-size:0.78rem;color:var(--muted);text-transform:uppercase;letter-spacing:0.08em;margin-bottom:0.6rem">
        {lang === 'fr' ? 'Photos' : 'Photos'}
      </div>
      <div class="photo-grid">
        {data.photos.map((src: string, i: number) => (
          <img src={src} alt={`${title} — photo ${i + 1}`} loading="lazy" />
        ))}
      </div>
    </>
  )}
</Base>
