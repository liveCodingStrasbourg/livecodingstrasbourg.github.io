---
import Base from '../../layouts/Base.astro';
import { getLangFromUrl, useTranslations } from '../../i18n';
import { getCollection } from 'astro:content';
import GeneratedCover from '../../components/GeneratedCover.astro';
import FriseHeading from '../../components/FriseHeading.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const allEvents = await getCollection('agenda');
const now = new Date();

const upcoming = allEvents
  .filter(e => new Date(e.data.date) >= now)
  .sort((a, b) => new Date(a.data.date).getTime() - new Date(b.data.date).getTime());

const past = allEvents
  .filter(e => new Date(e.data.date) < now)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const typeLabel: Record<string, string> = {
  'chaos-lab': 'Chaos Lab',
  atelier: 'Workshop',
  concert: 'Concert',
  jam: 'Jam',
  other: 'Other',
};

function renderCard(ev: any) {
  const title = ev.data.title_en ?? ev.data.title;
  const subtitle = ev.data.subtitle_en ?? ev.data.subtitle;
  const desc = ev.data.description_en ?? ev.data.description;
  const dateStr = new Date(ev.data.date).toLocaleDateString('en-GB', {
    day: 'numeric', month: 'long', year: 'numeric'
  });
  return { title, subtitle, desc, dateStr };
}
---
<Base title={t('agenda.title')}>
  <div class="page-header">
    <h1>{t('agenda.title')}</h1>
  </div>

  <FriseHeading label="Upcoming" />

  {upcoming.length === 0 ? (
    <p style="color:var(--muted)">{t('agenda.empty')}</p>
  ) : (
    <div class="chaos-grid">
      {upcoming.map(ev => {
        const { title, subtitle, desc, dateStr } = renderCard(ev);
        return (
          <a href={`/en/agenda/${ev.id}`} class="card">
            {ev.data.cover_image ? (
              <img src={ev.data.cover_image} alt={title} style="width:100%;aspect-ratio:16/9;object-fit:cover;display:block;border-bottom:1px solid var(--border)" />
            ) : (
              <GeneratedCover seed={ev.data.title} ratio="16/9" />
            )}
            <div class="card__body">
              <div class="card__meta">
                {dateStr}
                {ev.data.time_start ? ` — ${ev.data.time_start}${ev.data.time_end ? ` – ${ev.data.time_end}` : ''}` : ''}
                {ev.data.duration ? ` — ${ev.data.duration}` : ''}
                {ev.data.location ? ` — ${ev.data.location}` : ''}
              </div>
              <div class="card__title">{title}</div>
              {subtitle && <div class="card__subtitle">{subtitle}</div>}
              <p style="font-size:0.85rem;margin:0.3rem 0 0.5rem;color:var(--muted)">{desc}</p>
              <span class="tag">{typeLabel[ev.data.type] ?? ev.data.type}</span>
              {ev.data.tags?.map((tag: string) => <span class="tag">{tag}</span>)}
            </div>
          </a>
        );
      })}
    </div>
  )}

  {past.length > 0 && (
    <>
      <FriseHeading label="Past events" />
      <div class="chaos-grid">
        {past.map(ev => {
          const { title, subtitle, dateStr } = renderCard(ev);
          return (
            <a href={`/en/agenda/${ev.id}`} class="card" style="opacity:0.72">
              {ev.data.cover_image ? (
                <img src={ev.data.cover_image} alt={title} style="width:100%;aspect-ratio:16/9;object-fit:cover;display:block;border-bottom:1px solid var(--border)" />
              ) : (
                <GeneratedCover seed={ev.data.title} ratio="16/9" />
              )}
              <div class="card__body">
                <div class="card__meta">
                  {dateStr}{ev.data.location ? ` — ${ev.data.location}` : ''}
                </div>
                <div class="card__title">{title}</div>
                {subtitle && <div class="card__subtitle">{subtitle}</div>}
                {ev.data.participants?.length > 0 && (
                  <div style="font-size:0.78rem;color:var(--muted);margin-top:0.2rem">
                    {ev.data.participants.join(', ')}
                  </div>
                )}
                <div style="margin-top:0.4rem">
                  <span class="tag">{typeLabel[ev.data.type] ?? ev.data.type}</span>
                  {ev.data.tags?.map((tag: string) => <span class="tag">{tag}</span>)}
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </>
  )}
</Base>
