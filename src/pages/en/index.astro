---
import Base from '../../layouts/Base.astro';
import GeneratedCover from '../../components/GeneratedCover.astro';
import FriseHeading from '../../components/FriseHeading.astro';
import { getLangFromUrl, useTranslations } from '../../i18n';
import { getCollection } from 'astro:content';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const allEvents = await getCollection('agenda');
const upcoming = allEvents
  .filter(e => new Date(e.data.date) >= new Date())
  .sort((a, b) => new Date(a.data.date).getTime() - new Date(b.data.date).getTime())
  .slice(0, 4);

const [next, ...rest] = upcoming;

function eventTitle(ev: (typeof upcoming)[number]) {
  return ev.data.title_en ?? ev.data.title;
}
function eventDesc(ev: (typeof upcoming)[number]) {
  return ev.data.description_en ?? ev.data.description;
}
function eventDate(ev: (typeof upcoming)[number]) {
  return new Date(ev.data.date).toLocaleDateString('en-GB', {
    day: 'numeric', month: 'long', year: 'numeric'
  });
}
---
<Base>
  <div class="home-hero">
    <img src="/images/toplap-strasbourg-logo.webp" alt="TOPLAP Strasbourg" class="home-logo" />
    <p class="home-hero__tagline">{t('site.tagline')}</p>
    <div class="home-hero__cta">
      <a href="/en/agenda">→ Upcoming events</a>
      <a href="/en/contact" class="secondary">Get in touch</a>
    </div>
  </div>

  {next && (
    <a href={`/en/agenda/${next.id}`} class="next-event">
      {next.data.cover_image ? (
        <img src={next.data.cover_image} alt={eventTitle(next)} class="next-event__cover" />
      ) : (
        <GeneratedCover seed={next.data.title} ratio="21/7" />
      )}
      <div class="next-event__body">
        <div class="next-event__eyebrow">Next event</div>
        <div class="next-event__title">{eventTitle(next)}</div>
        <div class="next-event__meta">
          {eventDate(next)}
          {next.data.time_start ? ` — ${next.data.time_start}` : ''}
          {next.data.location ? ` — ${next.data.location}` : ''}
        </div>
      </div>
    </a>
  )}

  <FriseHeading label="Who we are" />
  <p style="line-height:1.7">
    <strong>TOPLAP Strasbourg</strong> is a non-profit association dedicated to <strong>innovative digital creation in all its forms</strong>. Rooted in the international <strong>TOPLAP</strong> network (<em>The Organisation for the Promotion of Live Algorithm Programming</em>), a worldwide collective born in 2004 around <em>live coding</em>, we share its spirit while carrying a broader ambition: to give Strasbourg a home for digital art in all its diversity.
  </p>
  <p style="line-height:1.7">
    <em>Live coding</em> — writing and modifying code in real time, often projected on screen, to generate sound and image in front of an audience — is one of our founding practices. But we don't stop there: audiovisual performance, VJing and visual arts, innovative scenography, installations and participatory devices, where the audience isn't just watching but taking part in the work.
  </p>
  <p style="line-height:1.7">
    Two commitments run through everything we do: <strong>free/libre and open-source culture</strong> — sharing tools, source code and know-how — and <strong>transmission</strong>, through education, training and outreach, to make digital creation accessible to everyone. The association brings together artists, VJs, developers, musicians, visual artists, scenographers, teachers, and curious amateurs around digital art and experimentation.
  </p>
  <p style="line-height:1.7;color:var(--muted);font-size:0.9rem">
    Our recurring events — the <strong>Chaos Labs</strong> — bring together live coders, VJs and audiences in an algorave spirit: projected code, music generated live, real-time image. Between shows, <strong>workshops</strong> open to all levels keep transmission going day to day.
  </p>

  {rest.length > 0 && (
    <>
      <FriseHeading label="Also coming up" />
      <div class="card-grid">
        {rest.map(ev => (
          <div class="card">
            <div class="card__meta">
              {eventDate(ev)}
              {ev.data.time_start ? ` — ${ev.data.time_start}` : ''}
              {ev.data.location ? ` — ${ev.data.location}` : ''}
            </div>
            <div class="card__title">{eventTitle(ev)}</div>
            <p style="font-size:0.85rem;color:var(--muted);margin:0">{eventDesc(ev)}</p>
            {ev.data.tags?.map((tag: string) => <span class="tag">{tag}</span>)}
          </div>
        ))}
      </div>
    </>
  )}

  {upcoming.length === 0 && (
    <>
      <FriseHeading label={t('nav.agenda')} />
      <p style="color:var(--muted)">{t('agenda.empty')}</p>
    </>
  )}

  <FriseHeading label="FAQ" />
  <div class="faq">
    <details>
      <summary>What is live coding?</summary>
      <p>Live coding is an artistic practice where you write and modify computer code live to create music, visuals or other forms of artistic expression. It's a way of merging programming and performance.</p>
    </details>
    <details>
      <summary>Do I need to know how to code?</summary>
      <p>No, no prior programming experience is needed. Our workshops are designed to be accessible at every level, including complete beginners. We'll guide you through your first steps.</p>
    </details>
    <details>
      <summary>Should I bring my own equipment?</summary>
      <p>We encourage you to bring your laptop and headphones if you have them, so you can practise during the workshop. Without a computer you can still take part by watching or sharing with other participants.</p>
    </details>
    <details>
      <summary>Do the workshops cost anything?</summary>
      <p>Our workshops are pay-what-you-want: everyone contributes according to their means. There's no obligation, but contributing helps keep the workshops going. You're also welcome to come without signing up.</p>
    </details>
    <details>
      <summary>How do I hear about upcoming workshops?</summary>
      <p>The best way is to join our Discord server (link on the <a href="/en/contact">contact</a> page). You can also follow the <a href="/en/agenda">agenda</a>, its <a href="/rss.xml">RSS feed</a> or our social media.</p>
    </details>
  </div>

  <hr />

  <p style="font-size:0.85rem;color:var(--muted)">
    <a href="/en/agenda">→ {t('nav.agenda')}</a> &nbsp;
    <a href="/en/artists">→ {t('nav.artists')}</a> &nbsp;
    <a href="/en/ressources">→ {t('nav.tools')}</a>
  </p>
</Base>
