---
import Base from '../../../layouts/Base.astro';
const i18n = "{\"alone\": \"Nobody else here yet.\", \"one\": \"1 other ghost here.\", \"many\": \"{n} other ghosts here.\", \"you\": \"you\", \"room\": \"Private room: {name} (share this page’s address)\"}";
---
<Base title="Ghosts" description="Visitors here at the same moment see each other and play together.">
  <p style="font-size:0.82rem;margin-bottom:1.2rem">
    <a href="/en/projects">← Projects</a>
  </p>

  <div class="page-header">
    <h1>Ghosts</h1>
    <p style="color:var(--muted)">Everyone on this page right now is a pixel. Move: your pixel plays on a shared clock, and you hear the others. Nobody is recorded — when you leave, your trace is gone.</p>
  </div>

  <div id="gh-root" data-i18n={i18n}>
    <p class="gh__room" id="gh-room"></p>
    <div class="gh">
      <canvas class="gh__canvas" id="gh-canvas"></canvas>
      <button type="button" class="gh__enter" id="gh-enter">Enter</button>
    </div>
    <p class="gh__count" id="gh-count"></p>
    <form class="gh__say" id="gh-say" hidden>
      <input id="gh-text" maxlength="80" autocomplete="off" placeholder="A word, 80 characters (fades after 8 s)" />
      <button type="submit">Say</button>
    </form>
    <ul class="gh__log" id="gh-log" aria-live="polite"></ul>
    <div class="gh__tools">
      <label>Instrument
        <select id="gh-instrument"><option value="0">Triangle</option><option value="1">Square</option><option value="2">Saw</option><option value="3">Sine</option></select>
      </label>
      <button type="button" id="gh-new-room">Create a private room</button>
    </div>
  </div>

  <p style="font-size:0.8rem;color:var(--muted)">Alone? Open this page in another tab or on your phone. Browsers connect directly (WebRTC, via public Nostr relays): no TOPLAP server, nothing is stored. Be kind: words show up for everyone.</p>

  <script is:inline type="module" src="/lab/fantomes.js"></script>
</Base>

<style>
  .gh {
    position: relative;
    height: 60vh;
    min-height: 320px;
    border: 1px solid var(--border);
    background: var(--surface);
    touch-action: none;
  }
  .gh__canvas {
    width: 100%;
    height: 100%;
    display: block;
    cursor: crosshair;
  }
  .gh__enter {
    position: absolute;
    inset: 0;
    margin: auto;
    width: max-content;
    height: max-content;
    font: inherit;
    font-size: 1rem;
    color: var(--on-accent);
    background: var(--accent);
    border: none;
    padding: 0.6rem 1.4rem;
    cursor: pointer;
  }
  .gh__room { font-size: 0.85rem; color: var(--accent); }
  .gh__count { font-size: 0.85rem; margin-top: 0.6rem; }
  .gh__say { display: flex; gap: 0.5rem; margin: 0.6rem 0; }
  .gh__say[hidden] { display: none; }
  .gh__say input, .gh__tools select {
    font: inherit;
    font-size: 0.9rem;
    color: var(--fg);
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 0.35rem 0.5rem;
  }
  .gh__say input { flex: 1; min-width: 0; }
  .gh__say button, .gh__tools button {
    font: inherit;
    font-size: 0.85rem;
    color: var(--fg);
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 0.35rem 0.8rem;
    cursor: pointer;
  }
  .gh__say button:hover, .gh__tools button:hover { border-color: var(--accent); color: var(--accent); }
  .gh__log { list-style: none; margin: 0.4rem 0; padding: 0; font-size: 0.85rem; min-height: 1.4rem; }
  .gh__tools { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; margin: 0.8rem 0; font-size: 0.85rem; color: var(--muted); }
</style>
