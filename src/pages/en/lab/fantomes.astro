---
import Base from '../../../layouts/Base.astro';
---
<Base title="Ghosts" description="Visitors here at the same moment see each other and play together.">
  <p style="font-size:0.82rem;margin-bottom:1.2rem">
    <a href="/en/projects">← Projects</a>
  </p>

  <div class="page-header">
    <h1>Ghosts</h1>
    <p style="color:var(--muted)">
      Everyone on this page right now is a pixel. Move: your pixel sings,
      and you hear the others. Nobody is recorded — when you leave, your trace is gone.
    </p>
  </div>

  <div class="gh">
    <canvas class="gh__canvas" id="gh-canvas"></canvas>
    <button type="button" class="gh__enter" id="gh-enter">Enter</button>
  </div>
  <p class="gh__count" id="gh-count"></p>
  <p style="font-size:0.8rem;color:var(--muted)">
    Alone? Open this page in another tab or on your phone.
    Browsers connect directly (WebRTC, via public Nostr relays): no TOPLAP server, nothing is stored.
  </p>

  <script is:inline type="module">
    import { joinRoom, selfId } from 'https://esm.run/trystero@0.26.0';

    const CELL = 10;                         // pixel grid, like the logo
    const SCALE = [0, 2, 4, 7, 9];           // pentatonic
    const canvas = document.getElementById('gh-canvas');
    const ctx = canvas.getContext('2d');
    const countEl = document.getElementById('gh-count');
    const ghosts = new Map();                // peerId -> {x, y, energy, trail, voice}
    let audio = null;
    let room = null;
    let move = null;

    const css = name => getComputedStyle(document.documentElement).getPropertyValue(name).trim();

    const resize = () => {
      const r = canvas.getBoundingClientRect();
      canvas.width = Math.round(r.width * devicePixelRatio);
      canvas.height = Math.round(r.height * devicePixelRatio);
    };
    addEventListener('resize', resize);
    resize();

    const pitch = x => {
      const step = Math.min(9, Math.floor(x * 10));
      const midi = 48 + 12 * Math.floor(step / 5) + SCALE[step % 5];
      return 440 * 2 ** ((midi - 69) / 12);
    };

    const makeVoice = (isSelf) => {
      const osc = audio.createOscillator();
      const filter = audio.createBiquadFilter();
      const gain = audio.createGain();
      osc.type = isSelf ? 'triangle' : 'sine';
      filter.type = 'lowpass';
      gain.gain.value = 0;
      osc.connect(filter).connect(gain).connect(audio.destination);
      osc.start();
      return { osc, filter, gain, stop: () => { gain.gain.setTargetAtTime(0, audio.currentTime, 0.1); setTimeout(() => osc.stop(), 500); } };
    };

    const ghost = (id, isSelf = false) => {
      if (!ghosts.has(id)) {
        ghosts.set(id, { x: 0.5, y: 0.5, energy: 0, trail: [], isSelf, voice: audio ? makeVoice(isSelf) : null });
      }
      return ghosts.get(id);
    };

    const place = (g, x, y) => {
      const dist = Math.hypot(x - g.x, y - g.y);
      g.energy = Math.min(1, g.energy + dist * 6);
      g.x = x; g.y = y;
      g.trail.push({ x, y, life: 1 });
      if (g.trail.length > 24) g.trail.shift();
      if (g.voice) {
        const t = audio.currentTime;
        g.voice.osc.frequency.setTargetAtTime(pitch(x), t, 0.03);
        g.voice.filter.frequency.setTargetAtTime(300 + (1 - y) * 3000, t, 0.05);
      }
    };

    const updateCount = () => {
      const others = ghosts.size - 1;
      countEl.textContent = !room ? ''
        : others <= 0 ? 'Nobody else here yet.'
        : others === 1 ? '1 other ghost here.'
        : `${others} other ghosts here.`;
    };

    const draw = () => {
      const w = canvas.width, h = canvas.height, c = CELL * devicePixelRatio;
      ctx.clearRect(0, 0, w, h);
      const ink = css('--fg') || '#fff';
      for (const g of ghosts.values()) {
        g.energy *= 0.94;
        if (g.voice) g.voice.gain.gain.setTargetAtTime((g.isSelf ? 0.12 : 0.07) * g.energy, audio.currentTime, 0.05);
        for (const p of g.trail) {
          p.life *= 0.93;
          ctx.globalAlpha = p.life * 0.5;
          ctx.fillStyle = g.isSelf ? '#FFED00' : ink;
          ctx.fillRect(Math.floor(p.x * w / c) * c, Math.floor(p.y * h / c) * c, c, c);
        }
        ctx.globalAlpha = 1;
        ctx.fillStyle = g.isSelf ? '#FFED00' : ink;
        const s = c * (2 + Math.round(g.energy * 2));
        ctx.fillRect(Math.floor(g.x * w / c) * c - s / 2, Math.floor(g.y * h / c) * c - s / 2, s, s);
      }
      requestAnimationFrame(draw);
    };
    requestAnimationFrame(draw);

    let last = 0;
    const onPointer = e => {
      if (!room) return;
      const r = canvas.getBoundingClientRect();
      const x = Math.min(1, Math.max(0, (e.clientX - r.left) / r.width));
      const y = Math.min(1, Math.max(0, (e.clientY - r.top) / r.height));
      place(ghost(selfId, true), x, y);
      const now = performance.now();
      if (now - last > 50) { last = now; move.send([x, y]); }
    };
    canvas.addEventListener('pointermove', onPointer);
    canvas.addEventListener('pointerdown', onPointer);

    document.getElementById('gh-enter').addEventListener('click', e => {
      e.currentTarget.hidden = true;
      audio = new AudioContext();
      for (const [id, g] of ghosts) g.voice ??= makeVoice(id === selfId);
      ghost(selfId, true);
      room = joinRoom({ appId: 'toplap-strasbourg-site' }, 'fantomes');
      move = room.makeAction('move');
      move.onMessage = (data, { peerId }) => {
        if (Array.isArray(data) && data.length === 2 && data.every(n => typeof n === 'number' && n >= 0 && n <= 1)) {
          place(ghost(peerId), data[0], data[1]);
        }
      };
      room.onPeerJoin = peerId => { ghost(peerId); updateCount(); };
      room.onPeerLeave = peerId => {
        ghosts.get(peerId)?.voice?.stop();
        ghosts.delete(peerId);
        updateCount();
      };
      updateCount();
    });

    addEventListener('pagehide', () => room?.leave());
  </script>
</Base>

<style>
  .gh {
    position: relative;
    height: 60vh;
    min-height: 320px;
    border: 1px solid var(--border);
    background: var(--surface);
    touch-action: none;
  }
  .gh__canvas {
    width: 100%;
    height: 100%;
    display: block;
    cursor: crosshair;
  }
  .gh__enter {
    position: absolute;
    inset: 0;
    margin: auto;
    width: max-content;
    height: max-content;
    font: inherit;
    font-size: 1rem;
    color: var(--on-accent);
    background: var(--accent);
    border: none;
    padding: 0.6rem 1.4rem;
    cursor: pointer;
  }
  .gh__count { font-size: 0.85rem; margin-top: 0.6rem; }
</style>
