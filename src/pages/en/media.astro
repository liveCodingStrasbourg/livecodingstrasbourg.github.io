---
import Base from '../../layouts/Base.astro';
import FriseHeading from '../../components/FriseHeading.astro';
import { getLangFromUrl, useTranslations } from '../../i18n';
import { getCollection } from 'astro:content';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const allMedia = await getCollection('media');

const typeOrder = ['video', 'image', 'audio', 'link'] as const;
const typeLabel: Record<(typeof typeOrder)[number], string> = {
  video: 'Videos',
  image: 'Photos',
  audio: 'Audio',
  link: 'Links',
};

const groups = typeOrder.map(type => ({
  type,
  items: allMedia
    .filter(m => m.data.type === type)
    .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()),
})).filter(g => g.items.length > 0);
---
<Base title={t('media.title')}>
  <div class="page-header">
    <h1>{t('media.title')}</h1>
  </div>

  {groups.map(({ type, items }) => (
    <>
      <FriseHeading label={typeLabel[type]} />
      <div class={type === 'image' ? 'media-thumbs' : undefined}>
      {items.map(item => {
        const title = item.data.title_en ?? item.data.title;
        const desc = item.data.description_en ?? item.data.description;
        const dateStr = new Date(item.data.date).toLocaleDateString('en-GB', {
          month: 'long', year: 'numeric'
        });
        return (
          <div class="media-embed">
            <div class="media-embed__title">{title} <span class="card__meta">— {dateStr}</span></div>
            {item.data.type === 'video' && item.data.url ? (
              <div class="video-wrapper">
                <iframe src={item.data.url} title={title} allowfullscreen loading="lazy"></iframe>
              </div>
            ) : item.data.type === 'image' && item.data.url ? (
              <a href={item.data.url} target="_blank" rel="noopener noreferrer" class="media-thumb">
                <img src={item.data.url} alt={title} loading="lazy" />
              </a>
            ) : (
              item.data.url && (
                <p><a href={item.data.url} target="_blank" rel="noopener noreferrer">{item.data.url}</a></p>
              )
            )}
            <p style="font-size:0.85rem;color:var(--muted);margin-top:0.4rem">{desc}</p>
          </div>
        );
      })}
      </div>
    </>
  ))}
  <FriseHeading label="Logo" />
  <p class="logo-downloads__credit">Logo designed by <strong>Sébastien Poilvert</strong> (520STill). Free to use when talking about TOPLAP Strasbourg and its events. Click a format to download it.</p>
  <div class="logo-downloads">
    <div class="logo-downloads__tile">
      <div class="logo-downloads__preview" style="background:#ffffff"><img src="/downloads/logo/TOPLAP-logo-couleur.svg" alt="Colour logo" loading="lazy" /></div>
      <div class="logo-downloads__name">Colour logo</div>
      <div class="logo-downloads__links"><a href="/downloads/logo/TOPLAP-logo-couleur.svg" download>SVG</a><a href="/downloads/logo/TOPLAP-logo-couleur-fond-transparent.png" download>PNG transparent</a><a href="/downloads/logo/TOPLAP-logo-couleur-fond-blanc.png" download>PNG white bg</a></div>
    </div>
    <div class="logo-downloads__tile">
      <div class="logo-downloads__preview" style="background:#ffffff"><img src="/downloads/logo/TOPLAP-logo-noir-et-blanc.svg" alt="Black & white logo" loading="lazy" /></div>
      <div class="logo-downloads__name">Black & white logo</div>
      <div class="logo-downloads__links"><a href="/downloads/logo/TOPLAP-logo-noir-et-blanc.svg" download>SVG</a><a href="/downloads/logo/TOPLAP-logo-noir-et-blanc-fond-blanc.png" download>PNG white bg</a></div>
    </div>
    <div class="logo-downloads__tile">
      <div class="logo-downloads__preview" style="background:#ffffff"><img src="/downloads/logo/TOPLAP-logo-noir-ajoure.svg" alt="Black cut-out logo" loading="lazy" /></div>
      <div class="logo-downloads__name">Black cut-out logo</div>
      <div class="logo-downloads__links"><a href="/downloads/logo/TOPLAP-logo-noir-ajoure.svg" download>SVG</a><a href="/downloads/logo/TOPLAP-logo-noir-fond-transparent.png" download>PNG transparent</a></div>
    </div>
    <div class="logo-downloads__tile">
      <div class="logo-downloads__preview" style="background:#111111"><img src="/downloads/logo/TOPLAP-logo-blanc.svg" alt="White cut-out logo" loading="lazy" /></div>
      <div class="logo-downloads__name">White cut-out logo</div>
      <div class="logo-downloads__links"><a href="/downloads/logo/TOPLAP-logo-blanc.svg" download>SVG</a><a href="/downloads/logo/TOPLAP-logo-blanc-fond-transparent.png" download>PNG transparent</a></div>
    </div>
    <div class="logo-downloads__tile">
      <div class="logo-downloads__preview" style="background:#ffffff"><img src="/downloads/logo/TOPLAP-carre-couleur-fond-blanc.png" alt="Square, colour" loading="lazy" /></div>
      <div class="logo-downloads__name">Square, colour</div>
      <div class="logo-downloads__links"><a href="/downloads/logo/TOPLAP-carre-couleur-fond-blanc.png" download>PNG white bg</a><a href="/downloads/logo/TOPLAP-carre-couleur-fond-transparent.png" download>PNG transparent</a></div>
