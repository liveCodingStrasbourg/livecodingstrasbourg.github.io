---
import Base from '../layouts/Base.astro';
import GeneratedCover from '../components/GeneratedCover.astro';
import FriseHeading from '../components/FriseHeading.astro';
import { getLangFromUrl, useTranslations } from '../i18n';
import { getCollection } from 'astro:content';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const allEvents = await getCollection('agenda');
const upcoming = allEvents
  .filter(e => new Date(e.data.date) >= new Date())
  .sort((a, b) => new Date(a.data.date).getTime() - new Date(b.data.date).getTime())
  .slice(0, 4);

const [next, ...rest] = upcoming;

function eventTitle(ev: (typeof upcoming)[number]) {
  return lang === 'en' && ev.data.title_en ? ev.data.title_en : ev.data.title;
}
function eventDesc(ev: (typeof upcoming)[number]) {
  return lang === 'en' && ev.data.description_en ? ev.data.description_en : ev.data.description;
}
function eventDate(ev: (typeof upcoming)[number]) {
  return new Date(ev.data.date).toLocaleDateString(lang === 'fr' ? 'fr-FR' : 'en-GB', {
    day: 'numeric', month: 'long', year: 'numeric'
  });
}
---
<Base>
  <div class="home-hero">
    <img src="/images/toplap-strasbourg-logo.webp" alt="TOPLAP Strasbourg" class="home-logo" />
    <p class="home-hero__tagline">{t('site.tagline')}</p>
    <div class="home-hero__cta">
      <a href="/agenda">{lang === 'fr' ? '→ Prochains évènements' : '→ Upcoming events'}</a>
      <a href="/contact" class="secondary">{lang === 'fr' ? 'Nous rejoindre' : 'Get in touch'}</a>
    </div>
  </div>

  {next && (
    <a href={`/agenda/${next.id}`} class="next-event">
      {next.data.cover_image ? (
        <img src={next.data.cover_image} alt={eventTitle(next)} class="next-event__cover" />
      ) : (
        <GeneratedCover seed={next.data.title} ratio="21/7" />
      )}
      <div class="next-event__body">
        <div class="next-event__eyebrow">{lang === 'fr' ? 'Prochain évènement' : 'Next event'}</div>
        <div class="next-event__title">{eventTitle(next)}</div>
        <div class="next-event__meta">
          {eventDate(next)}
          {next.data.time_start ? ` — ${next.data.time_start}` : ''}
          {next.data.location ? ` — ${next.data.location}` : ''}
        </div>
      </div>
    </a>
  )}

  <FriseHeading label={lang === 'fr' ? 'Qui sommes-nous ?' : 'Who we are'} />
  <p style="line-height:1.7">
    <strong>TOPLAP Strasbourg</strong> est une association à but non lucratif dédiée à la <strong>création numérique innovante sous toutes ses formes</strong>. Ancrée dans le réseau international <strong>TOPLAP</strong> (<em>The Organisation for the Promotion of Live Algorithm Programming</em>), collectif mondial né en 2004 autour du <em>live coding</em>, elle en partage l'esprit tout en portant une ambition plus large : faire vivre à Strasbourg un foyer de l'art numérique dans sa diversité.
  </p>
  <p style="line-height:1.7">
    Le <em>live coding</em> — écrire et modifier du code en temps réel, souvent projeté à l'écran, pour générer sons et images devant le public — est l'une de nos pratiques fondatrices. Mais nous ne nous y limitons pas : performance audiovisuelle, VJing et arts visuels, scénographie innovante, installations et dispositifs participatifs, où le public n'est pas seulement spectateur mais partie prenante de l'œuvre.
  </p>
  <p style="line-height:1.7">
    Deux engagements traversent toutes nos activités : la <strong>culture libre et l'open source</strong> — partage des outils, des codes sources et des savoir-faire — et la <strong>transmission</strong>, par l'éducation, la formation et la médiation, pour rendre la création numérique accessible à toutes et à tous. L'association réunit artistes, VJ, développeurs, musiciens, plasticiens, scénographes, enseignants, curieux et amateurs autour de l'art numérique et de l'expérimentation.
  </p>
  <p style="line-height:1.7;color:var(--muted);font-size:0.9rem">
    Nos rendez-vous réguliers — les <strong>Chaos Labs</strong> — rassemblent live codeurs, VJ et public dans une logique d'algorave : code projeté, musique générée en direct, image en temps réel. Entre deux soirées, des <strong>ateliers</strong> ouverts à tous les niveaux font vivre la transmission au quotidien.
  </p>

  {rest.length > 0 && (
    <>
      <FriseHeading label={lang === 'fr' ? 'Et ensuite' : 'Also coming up'} />
      <div class="card-grid">
        {rest.map(ev => (
          <div class="card">
            <div class="card__meta">
              {eventDate(ev)}
              {ev.data.time_start ? ` — ${ev.data.time_start}` : ''}
              {ev.data.location ? ` — ${ev.data.location}` : ''}
            </div>
            <div class="card__title">{eventTitle(ev)}</div>
            <p style="font-size:0.85rem;color:var(--muted);margin:0">{eventDesc(ev)}</p>
            {ev.data.tags?.map((tag: string) => <span class="tag">{tag}</span>)}
          </div>
        ))}
      </div>
    </>
  )}

  {upcoming.length === 0 && (
    <>
      <FriseHeading label={t('nav.agenda')} />
      <p class="muted">{t('agenda.empty')}</p>
    </>
  )}

  <FriseHeading label="Questions fréquentes" />
  <div class="faq">
    <details>
      <summary>Qu'est-ce que le live coding ?</summary>
      <p>Le live coding est une pratique artistique qui consiste à écrire et modifier du code informatique en direct pour créer de la musique, des visuels ou d'autres formes d'expression artistique. C'est une façon de fusionner programmation et performance artistique.</p>
    </details>
    <details>
      <summary>Faut-il savoir programmer pour participer ?</summary>
      <p>Non, aucune expertise préalable en programmation n'est nécessaire. Nos ateliers sont conçus pour être accessibles à tous les niveaux, y compris aux débutants complets. Nous vous accompagnons dans vos premiers pas.</p>
    </details>
    <details>
      <summary>Faut-il apporter son matériel ?</summary>
      <p>Nous vous encourageons à apporter votre ordinateur portable et un casque si vous en avez un, pour pratiquer directement pendant l'atelier. Sans ordinateur, vous pouvez toujours participer en observant ou en partageant avec d'autres participant·es.</p>
    </details>
    <details>
      <summary>Les ateliers sont-ils payants ?</summary>
      <p>Nos ateliers sont à prix libre : chacun·e contribue selon ses moyens. Il n'y a pas d'obligation, mais contribuer aide à faire perdurer ces ateliers. Il est aussi tout à fait possible de venir sans s'inscrire.</p>
    </details>
    <details>
      <summary>Comment être informé·e des prochains ateliers ?</summary>
      <p>Le meilleur moyen est de rejoindre notre serveur Discord (lien sur la page <a href="/contact">contact</a>). Vous pouvez aussi suivre l'<a href="/agenda">agenda</a>, son <a href="/rss.xml">flux RSS</a> ou nos réseaux sociaux.</p>
    </details>
  </div>

  <hr />

  <p style="font-size:0.85rem;color:var(--muted)">
    <a href="/agenda">→ {t('nav.agenda')}</a> &nbsp;
    <a href="/artists">→ {t('nav.artists')}</a> &nbsp;
    <a href="/ressources">→ {t('nav.tools')}</a>
  </p>
</Base>
