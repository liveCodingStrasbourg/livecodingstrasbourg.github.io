---
import Base from '../../layouts/Base.astro';
---
<Base title="Cadavre exquis codé" description="Ajoutez une ligne de Strudel au morceau et passez le lien." noindex>
  <div class="page-header">
    <h1>Cadavre exquis codé</h1>
    <p style="color:var(--muted)">
      Un morceau qui n'existe que dans les liens qu'on se passe. Écoutez, ajoutez une ligne de
      <a href="https://strudel.cc" target="_blank" rel="noopener noreferrer">Strudel</a>,
      puis transmettez le lien à quelqu'un d'autre.
    </p>
  </div>

  <section class="cx">
    <ol class="cx__lines" id="cx-lines"></ol>

    <div class="cx__controls">
      <button type="button" id="cx-play">▶ Jouer</button>
      <button type="button" id="cx-stop">■ Stop</button>
      <span class="cx__status" id="cx-status"></span>
    </div>

    <form class="cx__form" id="cx-form">
      <label>
        Votre ligne
        <input id="cx-code" maxlength="140" autocomplete="off" spellcheck="false"
          placeholder='note("c3 eb3 g3").s("sawtooth").lpf(800)' required />
      </label>
      <label>
        Pseudo (facultatif)
        <input id="cx-name" maxlength="20" autocomplete="nickname" />
      </label>
      <div class="cx__controls">
        <button type="button" id="cx-try">Essayer avec ma ligne</button>
        <button type="submit">Ajouter et passer le relais</button>
      </div>
      <p class="cx__share" id="cx-share" hidden>
        Lien copié. Envoyez-le à la prochaine personne :<br />
        <input id="cx-link" readonly />
      </p>
    </form>

    <details class="cx__help">
      <summary>Quelques idées de lignes</summary>
      <ul>
        <li><code>s("bd*2 [~ sd] bd sd")</code> — une batterie</li>
        <li><code>s("hh*8").gain(.4)</code> — des charleys</li>
        <li><code>note("c2 ~ eb2 g1").s("sawtooth").lpf(400)</code> — une basse</li>
        <li><code>note("&lt;c4 eb4 g4 bb4&gt;*4").s("triangle").room(.5)</code> — une mélodie</li>
        <li><code>s("cp").euclid(3,8).delay(.3)</code> — un rythme euclidien</li>
      </ul>
      <p>Une ligne = une expression Strudel (pas de <code>;</code>). Toutes les lignes jouent ensemble.</p>
    </details>
  </section>

  <script is:inline src="https://unpkg.com/@strudel/web@1.3.0"></script>
  <script is:inline>
    (() => {
      const MAX_LINES = 24;
      const SEED = [['', 's("bd*2 [~ sd] bd sd")']];
      // Strudel code is JavaScript: refuse lines that reach outside the music.
      const FORBIDDEN = /\b(window|document|globalThis|self|top|parent|location|localStorage|sessionStorage|indexedDB|cookie|fetch|XMLHttpRequest|WebSocket|import|eval|Function|constructor|prototype|__proto__|navigator|alert|open|postMessage)\b|=>|`/;

      const $ = id => document.getElementById(id);
      const status = msg => { $('cx-status').textContent = msg; };

      const encode = lines => {
        const bytes = new TextEncoder().encode(JSON.stringify(lines));
        let bin = '';
        bytes.forEach(b => { bin += String.fromCharCode(b); });
        return btoa(bin).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
      };
      const decode = str => {
        const bin = atob(str.replace(/-/g, '+').replace(/_/g, '/'));
        const bytes = Uint8Array.from(bin, c => c.charCodeAt(0));
        return JSON.parse(new TextDecoder().decode(bytes));
      };

      const clean = code => code.trim().replace(/[;,\s]+$/, '');
      const checkLine = code => {
        if (!code) return 'Ligne vide.';
        if (code.length > 140) return 'Ligne trop longue (140 caractères max).';
        if (FORBIDDEN.test(code)) return 'Cette ligne contient un mot réservé : restez dans la musique.';
        return '';
      };

      let lines = SEED;
      try {
        const m = location.hash.match(/^#p=(.+)$/);
        if (m) {
          const parsed = decode(m[1]);
          if (Array.isArray(parsed)) {
            lines = parsed
              .filter(l => Array.isArray(l) && typeof l[1] === 'string' && !checkLine(clean(l[1])))
              .slice(0, MAX_LINES)
              .map(([n, c]) => [String(n || '').slice(0, 20), clean(c)]);
          }
        }
      } catch {
        status('Lien illisible : on repart de zéro.');
      }

      const render = () => {
        const ol = $('cx-lines');
        ol.replaceChildren(...lines.map(([name, code]) => {
          const li = document.createElement('li');
          const c = document.createElement('code');
          c.textContent = code;
          li.append(c);
          if (name) {
            const s = document.createElement('span');
            s.className = 'cx__by';
            s.textContent = ' — ' + name;
            li.append(s);
          }
          return li;
        }));
        if (lines.length >= MAX_LINES) {
          status(`Morceau complet (${MAX_LINES} lignes). Écoutez-le !`);
          $('cx-form').hidden = true;
        }
      };

      const toCode = ls => `stack(\n${ls.map(([, c]) => '  ' + c).join(',\n')}\n)`;

      let ready = null;
      const init = () => {
        ready ??= initStrudel({
          prebake: () => strudel.samples('github:tidalcycles/dirt-samples'),
        });
        return ready;
      };

      const play = async ls => {
        status('Chargement…');
        try {
          await init();
          await strudel.evaluate(toCode(ls));
          status('▶ en cours');
          return true;
        } catch (e) {
          status('Erreur : ' + (e?.message ?? e));
          return false;
        }
      };

      const pending = () => {
        const code = clean($('cx-code').value);
        const err = checkLine(code);
        if (err) { status(err); return null; }
        return [$('cx-name').value.trim().slice(0, 20), code];
      };

      $('cx-play').addEventListener('click', () => play(lines));
      $('cx-stop').addEventListener('click', () => { if (ready) strudel.hush(); status('■ arrêté'); });
      $('cx-try').addEventListener('click', () => {
        const line = pending();
        if (line) play([...lines, line]);
      });
      $('cx-form').addEventListener('submit', async e => {
        e.preventDefault();
        const line = pending();
        if (!line) return;
        // Only pass on lines that actually play.
        if (!(await play([...lines, line]))) return;
        lines = [...lines, line];
        history.replaceState(null, '', '#p=' + encode(lines));
        render();
        $('cx-code').value = '';
        $('cx-link').value = location.href;
        $('cx-share').hidden = false;
        try { await navigator.clipboard.writeText(location.href); } catch {}
      });

      render();
    })();
  </script>
</Base>

<style>
  .cx__lines {
    margin: 0 0 1rem 1.4rem;
    font-size: 0.85rem;
  }
  .cx__lines li { margin: 0.2rem 0; }
  .cx__by { color: var(--muted); }
  .cx__controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin: 0.6rem 0;
  }
  .cx button {
    font: inherit;
    font-size: 0.85rem;
    color: var(--fg);
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 0.35rem 0.8rem;
    cursor: pointer;
  }
  .cx button:hover { border-color: var(--accent); color: var(--accent); }
  .cx__status { font-size: 0.8rem; color: var(--muted); }
  .cx__form label {
    display: block;
    font-size: 0.8rem;
    color: var(--muted);
    margin: 0.6rem 0;
  }
  .cx__form input {
    display: block;
    width: 100%;
    margin-top: 0.25rem;
    font: inherit;
    font-size: 0.9rem;
    color: var(--fg);
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 0.4rem 0.5rem;
  }
  .cx__share { font-size: 0.85rem; }
  .cx__help { margin-top: 1.5rem; font-size: 0.85rem; }
  .cx__help summary { cursor: pointer; }
</style>
