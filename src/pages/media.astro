    </div>
    <div class="logo-downloads__tile">
      <div class="logo-downloads__preview" style="background:#ffffff"><img src="/downloads/logo/TOPLAP-logo-noir-ajoure.svg" alt="Logo noir ajouré" loading="lazy" /></div>
      <div class="logo-downloads__name">Logo noir ajouré</div>
      <div class="logo-downloads__links"><a href="/downloads/logo/TOPLAP-logo-noir-ajoure.svg" download>SVG</a><a href="/downloads/logo/TOPLAP-logo-noir-fond-transparent.png" download>PNG transparent</a></div>
    </div>
    <div class="logo-downloads__tile">
      <div class="logo-downloads__preview" style="background:#111111"><img src="/downloads/logo/TOPLAP-logo-blanc.svg" alt="Logo blanc ajouré" loading="lazy" /></div>
