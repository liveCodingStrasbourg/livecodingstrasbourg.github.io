---
import Base from '../layouts/Base.astro';
import FriseHeading from '../components/FriseHeading.astro';
import { getLangFromUrl, useTranslations } from '../i18n';
import { getCollection } from 'astro:content';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const allMedia = await getCollection('media');

const typeOrder = ['video', 'image', 'audio', 'link'] as const;
const typeLabel: Record<(typeof typeOrder)[number], string> = {
  video: lang === 'fr' ? 'Vidéos' : 'Videos',
  image: lang === 'fr' ? 'Photos' : 'Photos',
  audio: lang === 'fr' ? 'Audio' : 'Audio',
  link: lang === 'fr' ? 'Liens' : 'Links',
};

const groups = typeOrder.map(type => ({
  type,
  items: allMedia
    .filter(m => m.data.type === type)
    .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()),
})).filter(g => g.items.length > 0);
---
<Base title={t('media.title')}>
  <div class="page-header">
    <h1>{t('media.title')}</h1>
  </div>

  {groups.map(({ type, items }) => (
    <>
      <FriseHeading label={typeLabel[type]} />
      <div class={type === 'image' ? 'media-thumbs' : undefined}>
      {items.map(item => {
        const title = lang === 'en' && item.data.title_en ? item.data.title_en : item.data.title;
        const desc = lang === 'en' && item.data.description_en ? item.data.description_en : item.data.description;
        const dateStr = new Date(item.data.date).toLocaleDateString(lang === 'fr' ? 'fr-FR' : 'en-GB', {
          month: 'long', year: 'numeric'
        });
        return (
          <div class="media-embed">
            <div class="media-embed__title">{title} <span class="card__meta">— {dateStr}</span></div>
            {item.data.type === 'video' && item.data.url ? (
              <div class="video-wrapper">
                <iframe src={item.data.url} title={title} allowfullscreen loading="lazy"></iframe>
              </div>
            ) : item.data.type === 'image' && item.data.url ? (
              <a href={item.data.url} target="_blank" rel="noopener noreferrer" class="media-thumb">
                <img src={item.data.url} alt={title} loading="lazy" />
              </a>
            ) : (
              item.data.url && (
                <p><a href={item.data.url} target="_blank" rel="noopener noreferrer">{item.data.url}</a></p>
              )
            )}
            <p style="font-size:0.85rem;color:var(--muted);margin-top:0.4rem">{desc}</p>
          </div>
        );
      })}
      </div>
    </>
  ))}
  <FriseHeading label="Logo" />
  <p class="logo-downloads__credit">Logo dessiné par <strong>Sébastien Poilvert</strong> (520STill). Libre d'utilisation pour parler de TOPLAP Strasbourg et de ses évènements. Cliquez sur un format pour le télécharger.</p>
  <div class="logo-downloads">
    <div class="logo-downloads__tile">
      <div class="logo-downloads__preview" style="background:#ffffff"><img src="/downloads/logo/TOPLAP-logo-couleur.svg" alt="Logo couleur" loading="lazy" /></div>
      <div class="logo-downloads__name">Logo couleur</div>
      <div class="logo-downloads__links"><a href="/downloads/logo/TOPLAP-logo-couleur.svg" download>SVG</a><a href="/downloads/logo/TOPLAP-logo-couleur-fond-transparent.png" download>PNG transparent</a><a href="/downloads/logo/TOPLAP-logo-couleur-fond-blanc.png" download>PNG fond blanc</a></div>
    </div>
    <div class="logo-downloads__tile">
      <div class="logo-downloads__preview" style="background:#ffffff"><img src="/downloads/logo/TOPLAP-logo-noir-et-blanc.svg" alt="Logo noir et blanc" loading="lazy" /></div>
